<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <!-- TOGGLE CAMPI / GRUPPI -->


    <!-- LISTA (RecyclerView) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleAlerts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFields"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/toggle_selected"
            android:checkable="true"
            android:checked="true"
            android:text="Campi"
            android:textColor="@color/toggle_text"
            app:checkedIcon="@null"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFieldGroups"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/toggle_selected"
            android:checkable="true"
            android:checked="false"
            android:text="Gruppi"
            android:textColor="@color/toggle_text"
            app:checkedIcon="@null"
            app:cornerRadius="24dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ImageView
        android:id="@+id/emptyImage"
        android:layout_width="51dp"
        android:layout_height="53dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toggleAlerts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        app:srcCompat="@drawable/ic_info" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Non hai creato nessun campo, clicca il bottone sotto per aggiungere un nuovo campo"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/emptyImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFields"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toggleAlerts"
        app:layout_constraintBottom_toTopOf="@id/btnAddField"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTTONE FISSO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aggiungi un nuovo campo"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

