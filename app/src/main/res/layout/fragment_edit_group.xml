<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Icona gruppo -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgGroupIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_group_default"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/txtGroupNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Nome gruppo -->

    <!-- Descrizione -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutDescription"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Descrizione">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Titolo lista campi -->
    <TextView
        android:id="@+id/txtFieldsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Lista campi"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Lista campi -->
    <ImageView
        android:id="@+id/noFieldsEditGroupImage"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_info" />

    <TextView
        android:id="@+id/noFieldsEditGroupText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center|center_horizontal|top"
        android:text="Questo gruppo non contiene nessun campo"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:visibility="visible" />

    <!-- Bottone salva -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="30dp"
        android:text="Salva modifiche"
        android:textColor="@color/white" />

</LinearLayout>
