<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- INDIRIZZO + ICONA LOCALIZZAZIONE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Indirizzo*"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FRAME MAPPA (inizialmente nascosto) -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- TIPOLOGIA CAMPO (DROPDOWN) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCropType"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tipologia campo*">

            <AutoCompleteTextView

                android:id="@+id/dropCropType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GRUPPO (DROPDOWN) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGroup"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Gruppo*">

            <AutoCompleteTextView
                android:id="@+id/dropGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTTONE IMPOSTA ALERT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modifica alert"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>
