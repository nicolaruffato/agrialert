<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- ICONA ALERT -->
        <ImageView
            android:id="@+id/imgAlertIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_alert" />


        <!-- COLONNA TESTI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vento Forte"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtAlertThreshold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vento > 60 km/h"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtAlertFieldAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Via Verdirdi, Mestre"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- COLONNA DESTRA: DATA + SWITCH  + LABEL SOTTO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- DATA -->
            <TextView
                android:id="@+id/txtAlertTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oggi"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- SWITCH  -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:layout_marginBottom="0dp" />

            <!-- LABEL SOTTO LO SWITCH -->
            <TextView
                android:id="@+id/txtResolvedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risolto"
                android:textSize="13sp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="7dp"/>
        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
