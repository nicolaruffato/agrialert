<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ICONA GRANDE DEL CAMPO -->
        <ImageView
            android:id="@+id/imgFieldIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_ortaggi"
            android:layout_marginBottom="16dp" />

        <!-- INDIRIZZO -->
        <TextView
            android:id="@+id/txtFieldAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Via Verdirdi, 15 - Mestre (VE)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <!-- COLTURA -->
        <TextView
            android:id="@+id/txtFieldCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ortaggi"
            android:textSize="16sp"
            android:gravity="center"/>

        <!-- GRUPPO -->
        <TextView
            android:id="@+id/txtFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gruppo: Prova"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- TITOLO LISTA ALERT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert associati"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- LISTA ALERT DEL CAMPO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFieldAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- BOTTONI FONDO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modifica campo"
            android:layout_marginTop="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elimina campo"
            android:layout_marginTop="12dp"
            app:backgroundTint="@android:color/holo_red_light"/>
    </LinearLayout>

</ScrollView>
